class_name {{prefix_pascal}}PaletteColorResource
extends Resource

## One palette color, by cell: nothing but the column and row in the LPC
## palette (Godot 4) -- no preset, no emission.
##
## For everything that needs a color FROM the palette without running the LPC
## shaders: a decal, a [Label3D], a UI swatch, a [Light3D], a particle
## modulate. Ask it with [method get_color]. Saving the cell instead of a plain
## [Color] keeps it tied to the palette: after a re-export with changed
## palette parameters it takes on the new color of its cell, exactly like the
## painted meshes do.
##
## [{{prefix_pascal}}SinglecolorResource] extends this class with a preset and an
## emission override for meshes running {{prefix}}singlecolor.tres. So an
## export typed as this class accepts both -- a pod's paint can be reused as
## the color of a sign as is.
##
## Regenerated on every export -- do not edit. The .tres files you author from
## it are yours and are never touched.


## The palette as it stood at the last export: its parameters, and every
## cell's color as the add-on computed it ([constant PALETTE]). [method color_at]
## reads that array instead of recomputing anything or loading a texture, so it
## follows every palette setting (groups, columns, hue shift, warmth, ...) and the
## script stays free of references to the other exported files -- it does not
## care where in the project they live.
##
## Public on purpose: anything else that needs to reason about the palette
## (a swatch grid, a "nearest cell to this color" lookup, an editor tool)
## should build on these instead of hard-coding a second copy.
##
## Re-exporting after a palette change rewrites this block. Already-authored
## .tres files keep their cell coordinates and simply take on the new color
## there -- exactly what happens to the painted meshes.

## Total columns of the grid (all groups, a two-column ramp counted twice) --
## the bound [member palette_cell_x] is clamped to.
const PALETTE_COLS: int = {{palette_cols}}

## Rows in the grid, from row 0 (lightest) to the last row (darkest).
## [member palette_cell_y] is clamped to it.
const PALETTE_ROWS: int = {{palette_rows}}

## How much chroma fades toward the lightest row (row 0), 0..1.
const PALETTE_TINT: float = {{palette_tint}}

## How much chroma fades toward the darkest row (the last one), 0..1.
const PALETTE_SHADE: float = {{palette_shade}}

## Temperature drift across the rows, -1..1 (0 = none).
const PALETTE_HUE_SHIFT: float = {{palette_hue_shift}}

## Global temperature bias, -1..1 (0 = neutral).
const PALETTE_WARMTH: float = {{palette_warmth}}

## The palette's groups, left to right: [code]name[/code], the [code]first[/code]
## grid column and the column [code]count[/code] (a two-column ramp counts twice).
const PALETTE_GROUPS: Array[Dictionary] = [
{{palette_groups_gdscript}}
]

## "Group · Column" for every grid column, index = x. The two halves of a
## two-column ramp are "Column 1/2" and "Column 2/2".
const PALETTE_COLUMN_NAMES: PackedStringArray = [
{{palette_column_names_gdscript}}
]

## Every cell's color, row by row: cell (x, y) sits at index
## [code]y * PALETTE_COLS + x[/code], row 0 first (the lightest row). Written by
## the add-on from the same computation that fills {{prefix}}palette.png.
const PALETTE: PackedColorArray = [
{{palette_colors_gdscript}}
]


## Palette column, in the same numbering the picker and the singlecolor
## shader's `lpc_palette_cell_x` use. The Inspector lists it by name
## ("Group · Column"); what is saved is the number.
##
## [b]Note:[/b] reordering, adding or removing columns in the add-on shifts the
## numbers -- a saved x then names a different column after the next export
## (the same as reordering presets). Painted meshes are remapped by the
## add-on; .tres files are not.
@export_enum(
		{{palette_cell_x_enum}}
) var palette_cell_x: int = 0:
	set(value):
		if palette_cell_x != value:
			palette_cell_x = value
			emit_changed()

## Palette row, in the same numbering the picker and the singlecolor shader's
## `lpc_palette_cell_y` use.
@export_range(0, {{palette_rows_max}}) var palette_cell_y: int = 0:
	set(value):
		if palette_cell_y != value:
			palette_cell_y = value
			emit_changed()

## The color of the chosen cell, shown read-only in the inspector so the cell
## numbers are not all you see. Always [method get_color]; never saved -- the
## cell is the source of truth, so a re-export with changed palette parameters
## shows the new color here as well.
@export_color_no_alpha var color: Color:
	get:
		return get_color()
	set(_value):
		pass


## The color of palette cell ([param x], [param y]) as an opaque [Color] --
## the palette carries no alpha, so it stays at 1.0.
##
## A lookup in [constant PALETTE], not a recomputation. The shaders sample the
## same values out of {{prefix}}palette.png, which rounds them to 8 bits per
## channel -- less than 1/255 apart, nothing an eye resolves, but do not compare
## the two for equality.
##
## Static, because a palette is one per export and not per color:
## [code]{{prefix_pascal}}PaletteColorResource.color_at(2, 3)[/code] works
## without a resource in hand.
##
## Coordinates outside the grid clamp to the edge cell instead of erroring --
## the same thing the shader's `repeat_disable` sampler does with an
## out-of-range UV, so both ends of the pipeline agree on nonsense input.
static func color_at(x: int, y: int) -> Color:
	var cx: int = clampi(x, 0, PALETTE_COLS - 1)
	var cy: int = clampi(y, 0, PALETTE_ROWS - 1)
	return PALETTE[cy * PALETTE_COLS + cx]


## This resource's own color: [method color_at] for the cell stored in
## [member palette_cell_x] / [member palette_cell_y].
##
## For everything that should match the mesh without running the shader -- a UI
## swatch, a [Light3D] color, a particle modulate, a fade the tween drives.
## This is the palette color alone; a subclass's preset or emission is not
## folded in, so a lamp look does not come back brighter here.
func get_color() -> Color:
	return color_at(palette_cell_x, palette_cell_y)


## Shows [member color] in the inspector without saving it, and greyed out:
## it follows the cell and cannot be set.
func _validate_property(property: Dictionary) -> void:
	if property.name == "color":
		property.usage = PROPERTY_USAGE_EDITOR | PROPERTY_USAGE_READ_ONLY
